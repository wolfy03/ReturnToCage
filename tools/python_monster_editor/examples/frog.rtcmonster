      {
        "path": "attack_patterns[leap_bite].events[EnableHitbox]",
        "reason": "FrogAttackState tests the target's origin against |dx| <= 44 and |dy| <= 40 on every tick of the leap. The 88x80 hitbox tests the target's hurtbox instead, which reaches further."
      },
      {
        "path": "behavior.states[return].params",
        "reason": "FrogReturnState switches to the short patrol hop (0.6 x speed, lift 230) once the origin is closer than one chase hop. The Hop module has one speed and lift per state."
      }
    ],

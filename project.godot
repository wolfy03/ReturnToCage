; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="ReturnToCage"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"
run/main_scene="res://core/boot.tscn"

[autoload]

ContentRegistry="*res://autoload/content_registry.gd"
GameSession="*res://autoload/game_session.gd"
SaveManager="*res://autoload/save_manager.gd"
SceneRouter="*res://autoload/scene_router.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input]

move_left={
"deadzone": 0.3,
"events": [Object(InputEventKey,"physical_keycode":65,"unicode":97)]
}
move_right={
"deadzone": 0.3,
"events": [Object(InputEventKey,"physical_keycode":68,"unicode":100)]
}
jump={
"deadzone": 0.3,
"events": [Object(InputEventKey,"physical_keycode":32,"unicode":32)]
}
interact={
"deadzone": 0.3,
"events": [Object(InputEventKey,"physical_keycode":69,"unicode":101)]
}
primary_attack={
"deadzone": 0.3,
"events": [Object(InputEventKey,"physical_keycode":74,"unicode":106)]
}
use_quick_item={
"deadzone": 0.3,
"events": [Object(InputEventKey,"physical_keycode":81,"unicode":113)]
}
open_inventory={
"deadzone": 0.3,
"events": [Object(InputEventKey,"physical_keycode":73,"unicode":105)]
}
pause={
"deadzone": 0.3,
"events": [Object(InputEventKey,"physical_keycode":4194305)]
}
debug_panel={
"deadzone": 0.3,
"events": [Object(InputEventKey,"physical_keycode":4194341)]
}

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"

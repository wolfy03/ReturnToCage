[ext_resource path="res://data/definitions/region_definition.gd" type="Script" id="1"]
[resource]
script = ExtResource("1")
id = &"forest_region"
display_name = "Forest Trail"
description = "A sunlit trail of roots and fallen logs. Beetles patrol the flats."

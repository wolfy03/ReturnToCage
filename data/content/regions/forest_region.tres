enemy_ids = Array[StringName]([&"sewer_beetle"])
recommended_gear = "Sharpened Twig, berries, clean water"
environment_path = "res://world/environment/presets/forest_environment.tres"
environment_loading_color = Color(0.5882353, 0.8039216, 0.88235295, 1)
